# Copy to .env.local and fill in. Never commit .env.local.

# Claude API key from console.anthropic.com (bill reading and document checks)
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sign-in buttons to show, comma-separated (enable each in Supabase first): google, azure, github
NEXT_PUBLIC_AUTH_PROVIDERS=
