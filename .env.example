# Copy to .env.local and fill in. Never commit .env.local.

# Claude API key from console.anthropic.com (bill reading and document checks)
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sign-in buttons to show, comma-separated (enable each in Supabase first): google, azure, github
NEXT_PUBLIC_AUTH_PROVIDERS=

# Show demo controls (sample patients, sample bills, sample dashboard data). Off for real patients.
DEMO_MODE=false

# Encrypts stored phone numbers and status links: openssl rand -base64 32
BARS_ENCRYPTION_KEY=

# Twilio. Leave blank to keep texts in the admin Outbox instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BARS_PUBLIC_URL=http://localhost:3100
BARS_CRON_SECRET=
# "messages" = send through this Mac's Messages app (demo). Twilio keys take priority.
SMS_PROVIDER=
